{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Administrator user profile and permissions",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "description": "System role",
          "enum": ["admin", "superadmin"]
        },
        "createdAt": {
          "type": "string",
          "description": "Registration ISO timestamp"
        }
      },
      "required": ["email", "role"]
    },
    "GradeBatch": {
      "title": "GradeBatch",
      "description": "Historical grade entries and monitoring records",
      "type": "object",
      "properties": {
        "jenjang": {
          "type": "string",
          "description": "Level (SMP or SMA)",
          "enum": ["SMP", "SMA"]
        },
        "kelas": {
          "type": "string",
          "description": "Class identifier",
          "maxLength": 64
        },
        "subject": {
          "type": "string",
          "description": "Subject name",
          "maxLength": 128
        },
        "submitterEmail": {
          "type": "string",
          "description": "Email of user submitting grades",
          "maxLength": 256
        },
        "submitterUid": {
          "type": "string",
          "description": "Firebase Auth UID of submitter",
          "maxLength": 128
        },
        "studentCount": {
          "type": "number",
          "description": "Total students in batch"
        },
        "averageScore": {
          "type": "number",
          "description": "Average score of the batch"
        },
        "highestScore": {
          "type": "number",
          "description": "Highest score recorded"
        },
        "lowestScore": {
          "type": "number",
          "description": "Lowest score recorded"
        },
        "grades": {
          "type": "string",
          "description": "JSON serialized records of student scores",
          "maxLength": 100000
        },
        "createdAt": {
          "type": "string",
          "description": "Submission ISO timestamp"
        }
      },
      "required": ["jenjang", "kelas", "subject", "submitterUid"]
    },
    "ConnectionTest": {
      "title": "ConnectionTest",
      "description": "Firestore connectivity verification entity",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "Connection test status",
          "maxLength": 64
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp string"
        }
      }
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/Admin"
      },
      "description": "Collection of verified administrator profiles"
    },
    "/batches/{batchId}": {
      "schema": {
        "$ref": "#/entities/GradeBatch"
      },
      "description": "Collection of submitted grade batches and monitoring logs"
    },
    "/test/{testId}": {
      "schema": {
        "$ref": "#/entities/ConnectionTest"
      },
      "description": "System health and connection check documents"
    }
  }
}
