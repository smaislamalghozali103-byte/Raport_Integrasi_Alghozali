rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "smaislamalghozali103@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAdmin(data) {
      return data.email is string && data.email.size() > 0 && data.email.size() <= 256 &&
             data.role is string && (data.role == 'admin' || data.role == 'superadmin');
    }

    function isValidGradeBatch(data) {
      return data.jenjang is string && (data.jenjang == 'SMP' || data.jenjang == 'SMA') &&
             data.kelas is string && data.kelas.size() > 0 && data.kelas.size() <= 64 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 128 &&
             data.submitterUid is string && data.submitterUid == request.auth.uid &&
             (!('submitterEmail' in data) || (data.submitterEmail is string && data.submitterEmail.size() <= 256)) &&
             (!('studentCount' in data) || (data.studentCount is number && data.studentCount >= 0 && data.studentCount <= 1000)) &&
             (!('averageScore' in data) || (data.averageScore is number && data.averageScore >= 0 && data.averageScore <= 100)) &&
             (!('highestScore' in data) || (data.highestScore is number && data.highestScore >= 0 && data.highestScore <= 100)) &&
             (!('lowestScore' in data) || (data.lowestScore is number && data.lowestScore >= 0 && data.lowestScore <= 100)) &&
             (!('grades' in data) || (data.grades is string && data.grades.size() <= 100000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow write: if isValidId(adminId) && isAdmin() && isValidAdmin(request.resource.data);
    }

    match /batches/{batchId} {
      allow get: if isValidId(batchId) && (isAdmin() || (isSignedIn() && resource.data.submitterUid == request.auth.uid));
      allow list: if isSignedIn() && (isAdmin() || resource.data.submitterUid == request.auth.uid);
      allow create: if isValidId(batchId) && isSignedIn() && isValidGradeBatch(request.resource.data);
      allow update: if isValidId(batchId) && isSignedIn() &&
        (isAdmin() || (resource.data.submitterUid == request.auth.uid && request.resource.data.submitterUid == resource.data.submitterUid)) &&
        isValidGradeBatch(request.resource.data);
      allow delete: if isValidId(batchId) && (isAdmin() || (isSignedIn() && resource.data.submitterUid == request.auth.uid));
    }

    match /test/{testId} {
      allow read, write: if isValidId(testId);
    }
  }
}
